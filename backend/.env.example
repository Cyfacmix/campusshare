# Copiez ce fichier en .env et adaptez les valeurs
SECRET_KEY=changez-moi-par-une-longue-chaine-aleatoire
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# mysql (defaut) ou sqlite (demarrage rapide sans MySQL)
DB_ENGINE=mysql
DB_NAME=campusshare
DB_USER=campus
DB_PASSWORD=campus_pass
DB_HOST=127.0.0.1
DB_PORT=3306
